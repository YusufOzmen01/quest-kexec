 	for (i = 0; i < num_clks; i++) {
 		if (!aop_qmp_clk_hws[i])
diff --git a/drivers/clk/qcom/dispcc-kona.c b/drivers/clk/qcom/dispcc-kona.c
index 7fe18865f5..91e1c511be 100644
--- a/drivers/clk/qcom/dispcc-kona.c
+++ b/drivers/clk/qcom/dispcc-kona.c
@@ -1532,6 +1532,27 @@ static int disp_cc_kona_probe(struct platform_device *pdev)
 		return PTR_ERR(regmap);
 	}
 
+	/*
+	 * qkx: disp_cc and gcc are both subsys_initcall; if disp_cc's link
+	 * order runs first, devm_clk_get("cfg_ahb_clk") returns -EPROBE_DEFER
+	 * and (with deferred-probe retries disabled kernel-wide in this
+	 * diagnostic build) that failure was permanent.
+	 *
+	 * A local msleep-based retry loop was tried here and made things
+	 * worse: subsys_initcall runs single-threaded, so blocking inside
+	 * disp_cc's own probe also blocks every later subsys_initcall from
+	 * running at all -- including gcc-kona's, which is the one thing
+	 * disp_cc is waiting on. Confirmed directly: dmesg showed a ~20s gap
+	 * with zero log lines from any driver, ending exactly at the retry
+	 * loop's own deadline, with gcc-kona's "Registered GCC clocks"
+	 * appearing only after. The loop was waiting for something it was
+	 * itself preventing from happening.
+	 *
+	 * The actual fix is below: disp_cc_kona_init() is registered at
+	 * fs_initcall, one level after subsys_initcall, so gcc-kona (and the
+	 * RPMh regulator framework, which registers even earlier at
+	 * arch_initcall) are guaranteed to have already run.
+	 */
 	clk = devm_clk_get(&pdev->dev, "cfg_ahb_clk");
 	if (IS_ERR(clk)) {
 		if (PTR_ERR(clk) != -EPROBE_DEFER)
@@ -1550,8 +1571,14 @@ static int disp_cc_kona_probe(struct platform_device *pdev)
 
 	dispcc_bus_id = msm_bus_scale_register_client(&clk_debugfs_scale_table);
 	if (!dispcc_bus_id) {
-		dev_err(&pdev->dev, "Unable to register for bw voting\n");
-		return -EPROBE_DEFER;
+		/*
+		 * qkx: after kexec msm_bus may never come up (deferred retries
+		 * are disabled in this diagnostic kernel), which would leave
+		 * every display clock missing. The vote only serves debugfs
+		 * clock measurement and all users check for a zero id.
+		 */
+		dev_warn(&pdev->dev,
+			 "qkx: bw voting unavailable; continuing without it\n");
 	}
 	for (i = 0; i < ARRAY_SIZE(disp_cc_kona_clocks); i++)
 		if (disp_cc_kona_clocks[i])
@@ -1587,7 +1614,8 @@ static int __init disp_cc_kona_init(void)
 {
 	return platform_driver_register(&disp_cc_kona_driver);
 }
-subsys_initcall(disp_cc_kona_init);
+/* qkx: was subsys_initcall; see the ordering comment in disp_cc_kona_probe(). */
+fs_initcall(disp_cc_kona_init);
 
 static void __exit disp_cc_kona_exit(void)
 {
diff --git a/drivers/clk/qcom/gdsc-regulator.c b/drivers/clk/qcom/gdsc-regulator.c
index ee8b6a2cde..f3fe105da1 100644
--- a/drivers/clk/qcom/gdsc-regulator.c
+++ b/drivers/clk/qcom/gdsc-regulator.c
@@ -842,14 +842,17 @@ static int gdsc_get_resources(struct gdsc *sc, struct platform_device *pdev)
 
 		sc->bus_handle = msm_bus_scale_register_client(sc->bus_pdata);
 		if (!sc->bus_handle) {
-			dev_err(&pdev->dev, "Failed to register bus client\n");
 			/*
-			 * msm_bus_scale_register_client() returns 0 for all
-			 * errors including when called before the bus driver
-			 * probes.  Therefore, return -EPROBE_DEFER here so that
-			 * probing can be retried and this case handled.
+			 * qkx: msm_bus does not reliably reprobe after kexec and
+			 * deferred-probe retries are disabled in this diagnostic
+			 * kernel. Returning -EPROBE_DEFER here permanently removes
+			 * GDSCs such as mdss_core_gdsc, preventing SDE RSC and DRM
+			 * from probing. All bus operations below already guard a
+			 * zero handle, so retain the inherited interconnect state
+			 * and continue without an explicit vote.
 			 */
-			return -EPROBE_DEFER;
+			dev_warn(&pdev->dev,
+				 "qkx: bus client unavailable; continuing without bus scaling\n");
 		}
 	}
 
diff --git a/drivers/cpufreq/cpufreq_stats.c b/drivers/cpufreq/cpufreq_stats.c
index 9ecc8a86f4..17e717d4a4 100644
--- a/drivers/cpufreq/cpufreq_stats.c
+++ b/drivers/cpufreq/cpufreq_stats.c
@@ -299,38 +299,17 @@ void cpufreq_stats_record_transition(struct cpufreq_policy *policy,
 	stats->total_trans++;
 }
 
+/*
+ * QKX: the vendor per-cpu idle/busy time-in-state accounting races
+ * against cpufreq_stats_create_table() on secondary CPUs (policy stats are
+ * published before the tables are fully coherent), causing NULL derefs in
+ * the idle path.  The accounting is pure diagnostics; disable it for the
+ * kexec diagnostic kernel.
+ */
 void cpufreq_stats_update_busy_time(struct task_struct *p, u64 cputime)
 {
-	struct cpufreq_policy *policy;
-	unsigned long flags;
-	unsigned int cpu;
-
-	cpu = task_cpu(p);
-	policy = cpufreq_cpu_get(cpu);
-	if (policy) {
-		if (policy->stats && !is_idle_task(p)) {
-			spin_lock_irqsave(&cpufreq_stats_lock, flags);
-			policy->stats->busy_time_in_state_per_cpu[cpu - policy->stats->cpu][policy->stats->last_index] += cputime;
-			spin_unlock_irqrestore(&cpufreq_stats_lock, flags);
-		}
-		cpufreq_cpu_put(policy);
-	}
 }
 
 void cpufreq_stats_update_idle_time(u64 cputime)
 {
-	struct cpufreq_policy *policy;
-	unsigned long flags;
-	unsigned int cpu;
-
-	cpu = smp_processor_id();
-	policy = cpufreq_cpu_get(cpu);
-	if (policy) {
-		if (policy->stats) {
-			spin_lock_irqsave(&cpufreq_stats_lock, flags);
-			policy->stats->idle_time_in_state_per_cpu[cpu - policy->stats->cpu][policy->stats->last_index] += cputime;
-			spin_unlock_irqrestore(&cpufreq_stats_lock, flags);
-		}
-		cpufreq_cpu_put(policy);
-	}
 }
diff --git a/drivers/iommu/arm-smmu.c b/drivers/iommu/arm-smmu.c
index f23ac48009..651fd11e14 100644
--- a/drivers/iommu/arm-smmu.c
+++ b/drivers/iommu/arm-smmu.c
@@ -5607,8 +5607,16 @@ static int arm_smmu_init_bus_scaling(struct arm_smmu_power_resources *pwr)
 
 	pwr->bus_client = msm_bus_scale_register_client(pwr->bus_dt_data);
 	if (!pwr->bus_client) {
-		dev_err(dev, "Bus client registration failed\n");
-		return -EPROBE_DEFER;
+		/*
+		 * qkx: after kexec the msm_bus fabric driver may never come up
+		 * (deferred retries are disabled in this diagnostic kernel), which
